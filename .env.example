# Server Configuration (Backend Environment Secrets)
PORT=5000
NODE_ENV=production
SESSION_SECRET=your_secure_random_session_secret_key_here
JWT_SECRET=your_secure_random_jwt_secret_key_here
DB_FILE_PATH=./data/database.json
DB_ENCRYPTION_KEY=your_secure_32_byte_aes_encryption_key_here
CONTACT_EMAIL=contact@blackline-creative.com
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Client Configuration (Vite Environment Variables - Public Safe ONLY)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_CONTACT_EMAIL=contact@blackline-creative.com
VITE_RECAPTCHA_SITE_KEY=
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
